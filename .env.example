# Copy to .env for local backend development. Never commit real credentials.
NOVA_DATABASE_URL=sqlite:///./nova.db
# Configure a long, unique admin bootstrap secret before creating scoped API keys.
NOVA_ADMIN_TOKEN=replace-with-a-long-random-secret
# Arena's OpenAI-compatible endpoint is the verified initial provider adapter.
NOVA_PROVIDER=arena
NOVA_PROVIDER_BASE_URL=https://api.arena.ai/v1
NOVA_PROVIDER_API_KEY=
NOVA_MODEL=coding-router-preview
# Required only when backend-side encrypted credential storage is enabled.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
NOVA_CREDENTIAL_ENCRYPTION_KEY=
# Optional comma-separated previous keys during rotation; remove only after stored rows are rotated.
NOVA_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# Exact hostname allow-list for custom HTTPS OpenAI-compatible gateway endpoints.
# Never use wildcards. Example placeholder only:
NOVA_GATEWAY_ALLOWED_HOSTS=gateway.example.org
NOVA_REQUEST_TIMEOUT_SECONDS=45
# Upper bounds for provider output and prompt size; per-agent context_length can lower prompt cap.
NOVA_MAX_COMPLETION_TOKENS=2048
NOVA_MAX_PROMPT_CHARACTERS=60000
# Optional ElevenLabs runtime credentials: set only in the server secret manager, never in Android.
# Voice profiles stay text/device-TTS only until this key is configured and a live authorized request succeeds.
NOVA_ELEVENLABS_API_KEY=
NOVA_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
NOVA_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
